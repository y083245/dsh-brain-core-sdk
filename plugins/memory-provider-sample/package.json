{
  "name": "@dsh-brain-core/plugin-memory-provider-sample",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "node --test \"test/*.test.ts\""
  },
  "brain": {
    "id": "memory-provider-sample",
    "kinds": ["memory-provider"],
    "api": "^1.0.0",
    "runtime": "process",
    "process": {
      "command": "node",
      "args": ["src/index.ts"]
    },
    "permissions": [
      "memory.readL0",
      "memory.writeDerived"
    ]
  },
  "devDependencies": {
    "@dsh-brain-core/sdk": "workspace:*",
    "@dsh-brain-core/testkit": "workspace:*"
  }
}
