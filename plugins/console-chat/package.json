{
  "name": "@dsh-brain-core/plugin-console-chat",
  "description": "Brain Core console chat channel with identity linking, message ingestion and agent wakeups.",
  "keywords": ["brain-core", "dsh-brain-core", "plugin", "channel", "chat"],
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "node --test \"test/*.test.ts\""
  },
  "brain": {
    "id": "console-chat",
    "kinds": ["channel"],
    "api": "^1.0.0",
    "runtime": "node",
    "permissions": [
      "channel.provide",
      "channel.send",
      "agent.session",
      "memory.ingest",
      "identity.link",
      "tools.register"
    ],
    "source": {
      "channels": ["console-chat:private:*", "console-chat:group:*"],
      "eventKinds": ["console-chat.message"],
      "defaultVisibility": "subject",
      "trust": "owner"
    },
    "tools": [
      {
        "name": "send_message",
        "effect": "send",
        "load": "core",
        "summary": "在控制台对话里发送一条消息",
        "textArg": "text"
      }
    ]
  },
  "dependencies": {
    "@dsh-brain-core/chat-kit": "workspace:*",
    "@dsh-brain-core/sdk": "workspace:*"
  },
  "devDependencies": {
    "@dsh-brain-core/testkit": "workspace:*"
  }
}
