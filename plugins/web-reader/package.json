{
  "name": "@dsh-brain-core/plugin-web-reader",
  "description": "Brain Core activity plugin for scheduled public web reading and evidence-backed memory.",
  "keywords": ["brain-core", "dsh-brain-core", "plugin", "activity", "web", "memory"],
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "node --test \"test/*.test.ts\""
  },
  "brain": {
    "id": "web-reader",
    "kinds": ["activity"],
    "api": "^1.0.0",
    "runtime": "node",
    "permissions": [
      "schedule.ownTime",
      "agent.session",
      "memory.ingest",
      "memory.record",
      "network:config:feeds"
    ],
    "config": "./src/config.ts",
    "source": {
      "channels": ["web-reader:feed:*"],
      "eventKinds": ["web-reader.article"],
      "defaultVisibility": "open",
      "trust": "external"
    }
  },
  "dependencies": {
    "@dsh-brain-core/sdk": "workspace:*"
  },
  "devDependencies": {
    "@dsh-brain-core/testkit": "workspace:*"
  }
}
