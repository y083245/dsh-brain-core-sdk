{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchHistoryItem",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "value": {},
    "text": {
      "type": "string"
    },
    "changedAt": {
      "type": "number"
    },
    "status": {
      "enum": [
        "outdated",
        "archived"
      ]
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "value",
    "text",
    "changedAt",
    "status",
    "label"
  ]
}
