{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordInput",
  "type": "object",
  "properties": {
    "layer": {
      "enum": [
        "L1",
        "L2"
      ]
    },
    "kind": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "actor": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "additionalProperties": {}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "maxItems": 100
    },
    "visibility": {
      "enum": [
        "open",
        "subject",
        "origin",
        "owner",
        "internal"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tEvent": {
      "type": "number"
    },
    "validFrom": {
      "type": "number"
    },
    "idempotencyKey": {
      "type": "string"
    }
  },
  "required": [
    "layer",
    "kind",
    "channel",
    "subjects",
    "actor",
    "content",
    "evidence"
  ]
}
