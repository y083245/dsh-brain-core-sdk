{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRecord",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "layer": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "kind": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "actor": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "additionalProperties": {}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "maxItems": 100
    },
    "visibility": {
      "enum": [
        "open",
        "subject",
        "origin",
        "owner",
        "internal"
      ]
    },
    "trust": {
      "enum": [
        "self",
        "owner",
        "member",
        "external"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tEvent": {
      "type": "number"
    },
    "tIngest": {
      "type": "number"
    },
    "status": {
      "enum": [
        "active",
        "outdated",
        "archived",
        "tombstoned"
      ]
    },
    "validFrom": {
      "type": "number"
    },
    "validTo": {
      "type": "number"
    },
    "version": {
      "type": "number"
    }
  },
  "required": [
    "id",
    "layer",
    "kind",
    "source",
    "channel",
    "subjects",
    "actor",
    "content",
    "evidence",
    "visibility",
    "trust",
    "confidence",
    "importance",
    "tEvent",
    "tIngest",
    "status",
    "version"
  ]
}
