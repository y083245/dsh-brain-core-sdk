{
  "name": "brain-core-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "build": "tsc -b && node apps/console/web/build-web.mjs",
    "lint": "eslint .",
    "test": "pnpm test:perf && pnpm test:unit",
    "test:perf": "node --test --test-concurrency=1 --test-name-pattern=PERF: spikes/s1/test/e3-bridge.test.ts spikes/s1/test/e8-storage.test.ts apps/kernel/test/memory-search/index.test.ts apps/kernel/test/memory-context/performance.test.ts apps/kernel/test/memory-api/service.test.ts apps/kernel/test/tool-gateway/dispatch.test.ts",
    "test:unit": "node --test --test-concurrency=1 --test-skip-pattern=PERF: \"packages/*/test/*.test.ts\" \"spikes/s1/test/*.test.ts\" \"apps/*/test/**/*.test.ts\" \"plugins/*/test/*.test.ts\" \"acceptance/*.test.ts\"",
    "verify": "pnpm build && pnpm lint && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
