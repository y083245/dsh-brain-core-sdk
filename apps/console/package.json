{
  "name": "@dsh-brain-core/console",
  "description": "INKTIDE web console for Brain Core plugins, memory, settings and model accounting.",
  "keywords": ["brain-core", "dsh-brain-core", "console", "inktide", "dashboard"],
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:web": "node web/build-web.mjs",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "check:textures": "node web/scripts/gen-textures.mjs --check",
    "check:fonts": "node web/scripts/subset-fonts.mjs --check"
  },
  "dependencies": {
    "@dsh-brain-core/satellite-host": "workspace:*",
    "@dsh-brain-core/sdk": "workspace:*",
    "@dsh-brain-core/shared": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "vite": "8.3.8"
  }
}
